{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/get_all_points": {
      "get": {
        "summary": "Get All Points",
        "operationId": "getAllPoints",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GlobePoint"
                  },
                  "type": "array",
                  "title": "Response Getallpoints"
                }
              }
            }
          }
        }
      }
    },
    "/api/request_anomaly": {
      "get": {
        "summary": "Request Anomaly",
        "description": "The anomaly within the search radius of the queried spot in that year,\nfound on the fly: its middle, radius, intensity and distance. With none,\nthe queried spot and the search radius at confidence 0. An anomaly found\nfor the first time that is among the largest goes on the leaderboard, and\n`claim` holds the token to name it. Each anomaly can be found only once:\nafter that, queries skip it.",
        "operationId": "requestAnomaly",
        "parameters": [
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Longitude"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Latitude"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Year"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Anomaly"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/found_anomalies": {
      "get": {
        "summary": "Get Found Anomalies",
        "description": "Every anomaly anyone has found, oldest find first. Kept in memory, so\nit empties when the server restarts.",
        "operationId": "getFoundAnomalies",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FoundAnomalyPoint"
                  },
                  "type": "array",
                  "title": "Response Getfoundanomalies"
                }
              }
            }
          }
        }
      }
    },
    "/api/leaderboard": {
      "get": {
        "summary": "Get Leaderboard",
        "description": "The largest anomalies found so far, largest first. Kept in memory, so\nit empties when the server restarts.",
        "operationId": "getLeaderboard",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LeaderboardEntry"
                  },
                  "type": "array",
                  "title": "Response Getleaderboard"
                }
              }
            }
          }
        }
      }
    },
    "/api/leaderboard/{entry_id}/name": {
      "put": {
        "summary": "Name Leaderboard Entry",
        "description": "Names an entry, once, with the token its finder was given.",
        "operationId": "nameLeaderboardEntry",
        "parameters": [
          {
            "name": "entry_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entry Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NameEntry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardEntry"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Anomaly": {
        "properties": {
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "intensity": {
            "type": "number",
            "title": "Intensity"
          },
          "radius": {
            "type": "number",
            "title": "Radius"
          },
          "distance": {
            "type": "number",
            "title": "Distance"
          },
          "claim": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LeaderboardClaim"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "longitude",
          "latitude",
          "confidence",
          "intensity",
          "radius",
          "distance"
        ],
        "title": "Anomaly",
        "description": "The largest anomaly near a queried spot: its middle and radius. With\nnone, the queried spot and the radius searched, at confidence 0."
      },
      "FoundAnomalyPoint": {
        "properties": {
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "event_time": {
            "type": "string",
            "title": "Event Time"
          },
          "radius": {
            "type": "number",
            "title": "Radius"
          },
          "intensity": {
            "type": "number",
            "title": "Intensity"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "longitude",
          "latitude",
          "event_time",
          "radius",
          "intensity",
          "confidence"
        ],
        "title": "FoundAnomalyPoint",
        "description": "An anomaly someone has found."
      },
      "GlobePoint": {
        "properties": {
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "event_time": {
            "type": "string",
            "title": "Event Time"
          },
          "radius": {
            "type": "number",
            "title": "Radius"
          }
        },
        "type": "object",
        "required": [
          "longitude",
          "latitude",
          "event_time",
          "radius"
        ],
        "title": "GlobePoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeaderboardClaim": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rank",
          "token"
        ],
        "title": "LeaderboardClaim",
        "description": "The anomaly a query found made the leaderboard. Only the finder gets\nthe token, which names the entry."
      },
      "LeaderboardEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "event_time": {
            "type": "string",
            "title": "Event Time"
          },
          "radius": {
            "type": "number",
            "title": "Radius"
          },
          "intensity": {
            "type": "number",
            "title": "Intensity"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rank",
          "name",
          "longitude",
          "latitude",
          "event_time",
          "radius",
          "intensity",
          "confidence"
        ],
        "title": "LeaderboardEntry",
        "description": "One of the largest anomalies found so far."
      },
      "NameEntry": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "name": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "token",
          "name"
        ],
        "title": "NameEntry"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
